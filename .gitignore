# Track only person-owned config. Herdr rewrites the rest on every start.
/*
!/.gitignore
!/settings.json
!/keys.json
!/programs.json
!/themes/
!/layouts/
!/mods/
!/backgrounds/
!/CLAUDE.md
!/GLOSSARY.md
!/docs/
# Shipped mods: Herdr replaces them whole on start. Clone before editing.
/mods/agents/
/mods/changes/
/mods/confirm/
/mods/files/
/mods/help/
/mods/machine-add/
/mods/menu/
/mods/new-menu/
/mods/pane/
/mods/peek/
/mods/picker/
/mods/prompt/
/mods/spaces/
/mods/tabs/
/mods/terminals-bar/
/mods/terminals-pane/
/mods/toast/
/mods/win98/
/mods/workspace-chrome/
/mods/workspace-status/
/mods/worktree/
*.error
*.reset-*
*.old-*
jsconfig.json
gpui-kit.d.ts
# Window state the app writes as you use it (panel sizes, shown/hidden rows).
/layouts/.state/
